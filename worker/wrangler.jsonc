{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s3-gear-generator-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "vars": {
    "F_GEN_URL": "https://nxapi-znca-api.fancy.org.uk/api/znca/f",
    "WEB_ORIGIN": "*",
    "S3_GEAR_GENERATOR_VERSION": "1.0.0",
    "APP_USER_AGENT": "Mozilla/5.0 (Linux; Android 14; Pixel 7a) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.230 Mobile Safari/537.36"
  },
  "secrets": {
    "required": [
      "NXAPI_AUTH_CLIENT_ID",
      "FLOW_SECRET"
    ]
  }
}